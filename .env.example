# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# src/deployment.mjs refuses a non-loopback bind, and refuses NODE_ENV=production,
# unless BOTH of these are configured: durable persistence (SUPABASE_* below) and
# EVENTPILOT_ACCESS_KEY. An incomplete deployment fails at startup rather than
# coming up as a public, unauthenticated database.

# ── Workspace access control ──────────────────────────────────────────────
# At least 16 characters. Gates every /api route except /api/health. The browser
# gets an HMAC-signed HttpOnly session cookie derived from this value — the value
# itself is never sent to the client. Rotating it logs every session out.
# EVENTPILOT_ACCESS_KEY=

# ── Durable persistence (Supabase Postgres over PostgREST) ────────────────
# When both are set the app stores events in Supabase instead of ./data/events.json.
# SUPABASE_REST_URL=https://<project-ref>.supabase.co/rest/v1
# SUPABASE_SERVICE_ROLE_KEY=            # bypasses RLS. Server-side only. Never in
#                                         # the browser bundle, a log line or the
#                                         # hackathon submission text.
# SUPABASE_EVENTS_TABLE=events
# Apply db/migrations/001_events.sql in the Supabase SQL editor before first start.

# ── AI provider selection ─────────────────────────────────────────────────
# auto (default) : Groq when GROQ_API_KEY exists, then Gemini, else deterministic
#                  templates. Local Ollama is never chosen automatically.
# groq | gemini | ollama | mock | none
EVENTPILOT_AI_PROVIDER=auto

# Groq free tier. The key's tokens-per-minute limit is the real constraint: one
# plan generation is about 1,450 tokens, so an 8,000 TPM key fits roughly five.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_ALLOW_CUSTOM_BASE_URL=false

# Google AI Studio key (alternative cloud provider).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_ALLOW_CUSTOM_BASE_URL=false

# ── Local Ollama (opt-in; it loads a model onto this machine) ─────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_ALLOW_REMOTE=false

# ── Guardrails ────────────────────────────────────────────────────────────
# At most one live generation at a time (protects free-tier quota).
EVENTPILOT_AI_CONCURRENCY=1
# Per-client AI requests per minute.
# EVENTPILOT_AI_RATE_LIMIT_PER_MINUTE=30

# Optional: keep the local file store somewhere other than ./data
# EVENTPILOT_DATA_DIR=C:\Users\You\.eventpilot

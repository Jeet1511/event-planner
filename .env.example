# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# Non-loopback binding and NODE_ENV=production are refused by src/deployment.mjs
# while the app has no authentication or tenant isolation. Keep it local.

# ── AI provider selection ─────────────────────────────────────────────────
# auto (default) : Gemini when GEMINI_API_KEY exists, otherwise local Ollama
# gemini | ollama | mock | none  : force one; "none" = deterministic templates only
EVENTPILOT_AI_PROVIDER=auto

# Google AI Studio free-tier key (never put this in chat, git or a browser bundle).
# Create it in AI Studio, then fill this file. Leave blank to use Ollama instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only change these two if you deliberately trust another endpoint with event data.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_ALLOW_CUSTOM_BASE_URL=false

# ── Local Ollama (small model: ~1 GB download, runs on CPU) ───────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Other ~2B options that handle JSON well: qwen3:1.7b, llama3.2:1b, granite4:micro
OLLAMA_ALLOW_REMOTE=false

# At most one live generation at a time (protects free-tier quota).
EVENTPILOT_AI_CONCURRENCY=1

# Optional: keep event data somewhere other than ./data
# EVENTPILOT_DATA_DIR=C:\Users\You\.eventpilot
